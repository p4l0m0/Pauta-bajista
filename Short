        clear_output(wait=True)
        ticker = w_ticker.value.strip()
        intervalo = w_tf.value
        print(f"Descargando {ticker} ({intervalo})...")
        df = descargar(ticker, intervalo)
        if df is None or len(df) < 80:
            print("No se han obtenido datos suficientes. Revisa el símbolo (formato Yahoo Finance).")
            return
        res, df = analizar(df)
        clear_output(wait=True)

        ok = lambda b: "🟢" if b else "🔴"
        nv = res["niveles"]
        cumplidas = sum([res["c1"], res["c2"], res["c3"]])

        print("=" * 74)
        print(f"  PAUTA DE TECHO CORTO — {ticker} ({intervalo})   |   Cierre: {nv['entrada']:.4f}")
        print("=" * 74)
        print(f"{ok(res['c1'])} CIRCUNSTANCIA 1 — Tendencia alcista previa y testeo/dilatación de resistencia")
        print(f"     {res['detalle']['c1']}")
        print(f"{ok(res['c2'])} CIRCUNSTANCIA 2 — Doble techo, ruptura del valle y perforación de la directriz")
        print(f"     {res['detalle']['c2']}")
        print(f"{ok(res['c3'])} CIRCUNSTANCIA 3 — Consolidación plana junto a EMA21/EMA50")
        print(f"     {res['detalle']['c3']}")
        print("-" * 74)
        print(f"  CIRCUNSTANCIAS CUMPLIDAS: {cumplidas}/3")
        if cumplidas == 3:
            print("  >> Pauta completa. Vigilar el giro a la baja desde la consolidación.")
        elif cumplidas == 2:
            print("  >> Pauta incompleta. En formación: esperar confirmación de la que falta.")
        else:
            print("  >> Sin pauta. No operar por este criterio.")
        print("-" * 74)
        print("  NIVELES ORIENTATIVOS (posición corta)")
        print(f"    Entrada (cierre actual) : {nv['entrada']:.4f}")
        print(f"    Stop Loss (máx + 0.5ATR): {nv['stop']:.4f}   (riesgo {nv['riesgo']:.4f})")
        print(f"    Objetivo 1:2            : {nv['obj2']:.4f}")
        print(f"    Objetivo 1:3            : {nv['obj3']:.4f}")
        print(f"    ATR(14)                 : {nv['atr']:.4f}")
        print("=" * 74)
        graficar(df, res, ticker, intervalo)


w_btn.on_click(on_click)
display(widgets.VBox([w_ticker, w_tf, w_btn, w_out]))
